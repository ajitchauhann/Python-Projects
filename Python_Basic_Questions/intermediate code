class CountDown:
    def __init__(self, start):
        self.start = start

    def __iter__(self):
        return self

    def __next__(self):
        if self.start <= 0:
            raise StopIteration
        current = self.start
        self.start -= 1
        return current

# Usage
for num in CountDown(5):
    print(num)




    from collections import Counter

def word_count(filename):
    with open(filename, 'r') as file:
        text = file.read().lower()
        words = text.split()
        return Counter(words)

result = word_count("sample.txt")

for word, count in result.most_common(5):
    print(word, count)