# Sales Forecasting + Anomaly Detection

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# -------------------------------
# Step 1: Generate Synthetic Sales Data
# -------------------------------
np.random.seed(42)

dates = pd.date_range(start="2022-01-01", periods=365)
sales = 200 + np.random.normal(0, 20, size=365).cumsum()  # trend + noise

df = pd.DataFrame({
    "Date": dates,
    "Sales": sales
})

df.set_index("Date", inplace=True)

# -------------------------------
# Step 2: Feature Engineering
# -------------------------------
df["Rolling_Mean_7"] = df["Sales"].rolling(window=7).mean()
df["Rolling_Std_7"] = df["Sales"].rolling(window=7).std()

# -------------------------------
# Step 3: Forecast (Simple Moving Avg)
# -------------------------------
forecast_days = 30
last_mean = df["Rolling_Mean_7"].iloc[-1]

future_dates = pd.date_range(start=df.index[-1], periods=forecast_days+1)[1:]
forecast = pd.DataFrame({
    "Date": future_dates,
    "Forecast_Sales": [last_mean] * forecast_days
})
forecast.set_index("Date", inplace=True)

# -------------------------------
# Step 4: Anomaly Detection (Z-score)
# -------------------------------
df["Z_Score"] = (df["Sales"] - df["Sales"].mean()) / df["Sales"].std()

df["Anomaly"] = df["Z_Score"].apply(lambda x: 1 if abs(x) > 2 else 0)

# -------------------------------
# Step 5: Visualization
# -------------------------------
plt.figure(figsize=(12,6))

plt.plot(df.index, df["Sales"], label="Sales")
plt.plot(df.index, df["Rolling_Mean_7"], label="7-Day Avg")

# Highlight anomalies
anomalies = df[df["Anomaly"] == 1]
plt.scatter(anomalies.index, anomalies["Sales"], label="Anomaly")

plt.title("Sales with Anomaly Detection")
plt.xlabel("Date")
plt.ylabel("Sales")
plt.legend()
plt.show()

# -------------------------------
# Step 6: Save Outputs
# -------------------------------
df.to_csv("sales_with_anomalies.csv")
forecast.to_csv("sales_forecast.csv")

print("Files saved: sales_with_anomalies.csv, sales_forecast.csv")