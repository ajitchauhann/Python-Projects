# Simple If-Else

age = 18

if age >= 18:
    print("You are eligible to vote")
else:
    print("You are not eligible to vote")


# If-Elif-Else 

marks = 75

if marks >= 90:
    print("Grade A")
elif marks >= 60:
    print("Grade B")
else:
    print("Grade C")



# Using User Input   

num = int(input("Enter a number: "))

if num % 2 == 0:
    print("Even number")
else:
    print("Odd number")

# Nested If
    
num = 10

if num > 0:
    if num % 2 == 0:
        print("Positive Even")
    else:
        print("Positive Odd")
else:
    print("Negative number")


# and , or 

age = 25
salary = 30000

if age > 18 and salary > 20000:
    print("Eligible for loan")

if age < 18 or salary < 20000:
    print("Not eligible")
