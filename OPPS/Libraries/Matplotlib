# Basic Matplotlib Example
import matplotlib.pyplot as plt

# Data
x = [1, 2, 3, 4, 5]
y = [10, 20, 15, 30, 25]

# Create graph
plt.plot(x, y)

# Title and labels
plt.title("Simple Line Graph")
plt.xlabel("X Values")
plt.ylabel("Y Values")

# Show graph
plt.show()



import matplotlib.pyplot as plt

# Data
subjects = ["Python", "Java", "C++", "JavaScript"]
students = [40, 25, 15, 30]

# Bar chart
plt.bar(subjects, students)

# Title
plt.title("Students Learning Programming")

# Labels
plt.xlabel("Languages")
plt.ylabel("Number of Students")

# Display chart
plt.show()



