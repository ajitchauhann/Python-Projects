# 1. Sales Analysis Dashboard

import matplotlib.pyplot as plt

months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]
sales = [1200, 1500, 1800, 1700, 2100, 2500]
profit = [200, 300, 400, 350, 500, 650]

plt.figure(figsize=(10, 5))

plt.plot(months, sales, marker='o', linewidth=3, label="Sales")
plt.plot(months, profit, marker='s', linewidth=3, label="Profit")

plt.title("Company Sales Dashboard")
plt.xlabel("Months")
plt.ylabel("Amount")
plt.grid(True)
plt.legend()

plt.show()

# 2. Student Marks Visualization

import matplotlib.pyplot as plt

students = ["Ajay", "Rohit", "Simran", "Aman", "Priya"]
python_marks = [78, 88, 92, 69, 85]
sql_marks = [80, 75, 89, 72, 90]

x = range(len(students))

plt.figure(figsize=(10, 5))

plt.bar(x, python_marks, width=0.4, label="Python", align='center')
plt.bar([i + 0.4 for i in x], sql_marks, width=0.4, label="SQL")

plt.xticks([i + 0.2 for i in x], students)

plt.title("Student Performance")
plt.xlabel("Students")
plt.ylabel("Marks")
plt.legend()

plt.show()



# 3. Weather Temperature Tracker

import matplotlib.pyplot as plt

days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
temperature = [32, 35, 34, 36, 38, 37, 33]

plt.figure(figsize=(9, 5))

bars = plt.bar(days, temperature)

for bar in bars:
    y = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, y + 0.2, y,
             ha='center')

plt.title("Weekly Temperature Report")
plt.ylabel("Temperature °C")

plt.show()





