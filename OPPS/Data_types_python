# String Example

text = "Python Programming"

print(text)
print(text.upper())
print(text.lower())
print(len(text))


# List Example

fruits = ["Apple", "Banana", "Mango"]

print(fruits)

fruits.append("Orange")

print(fruits)
print(fruits[1])


# Dictionary Example

student = {
    "name": "Ajit",
    "age": 21,
    "course": "Python"
}

print(student)

print(student["name"])
print(student["course"])


# Boolean
is_student = True
print("\nStudent:", is_student)
print("Type:", type(is_student))


# Set
numbers = {1, 2, 3, 4, 5}
print("\nNumbers:", numbers)
print("Type:", type(numbers))