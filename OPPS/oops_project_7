import json

class PasswordManager:
    def __init__(self, file="passwords.json"):
        self.file = file
        self.data = self.load()

    def load(self):
        try:
            with open(self.file, "r") as f:
                return json.load(f)
        except:
            return {}

    def save(self):
        with open(self.file, "w") as f:
            json.dump(self.data, f, indent=4)

    def add_password(self, site, password):
        self.data[site] = password
        self.save()

    def get_password(self, site):
        return self.data.get(site, "Not found")


pm = PasswordManager()
pm.add_password("gmail", "1234")
print(pm.get_password("gmail"))