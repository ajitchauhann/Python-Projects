# Simple Cricket Game
    
    import random

score = 0

print("🏏 Cricket Game (1 over = 6 balls)")

for ball in range(1, 7):
    user = int(input(f"Ball {ball} - Enter run (1-6): "))
    comp = random.randint(1, 6)

    print("Computer:", comp)

    if user == comp:
        print("❌ OUT!")
        break
    else:
        score += user

print("Your final score:", score)




# Penalty Shoot Game (Football style)

import random

goals = 0

for i in range(5):
    user = input("Choose direction (left, right, center): ")
    comp = random.choice(["left", "right", "center"])

    print("Goalkeeper chose:", comp)

    if user != comp:
        print("⚽ GOAL!")
        goals += 1
    else:
        print("❌ Saved!")

print("Total Goals:", goals)



