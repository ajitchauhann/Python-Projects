class Shape:
    def area(self):
        pass


class Rectangle(Shape):
    def __init__(self, l, w):
        self.l = l
        self.w = w

    def area(self):
        return self.l * self.w


class Circle(Shape):
    def __init__(self, r):
        self.r = r

    def area(self):
        return 3.14 * self.r * self.r


shapes = [Rectangle(4, 5), Circle(3)]

for s in shapes:
    print("Area:", s.area())


    
class Voting:
    def __init__(self):
        self.votes = {}

    def vote(self, name):
        self.votes[name] = self.votes.get(name, 0) + 1

    def result(self):
        print(self.votes)


v = Voting()
v.vote("A")
v.vote("B")
v.vote("A")
v.result()


class Ticket:
    def __init__(self, seat):
        self.seat = seat


class Booking:
    def __init__(self):
        self.booked = []

    def book(self, seat):
        if seat not in self.booked:
            self.booked.append(seat)
            print("Booked")
        else:
            print("Already taken")


b = Booking()
b.book(1)
b.book(1)




