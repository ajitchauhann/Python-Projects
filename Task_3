# Prime Number Checker
# Problem 8:- Check it a number is prime.

number = 5
is_prime = True

if number > 1:
  for i in range(2, number):
    if(number % i) == 0:
      is_prime = False
      break
print(is_prime)


# List Uniqueness Checker
# Problem 9:- Check if all elements in a list are unique. If a duplicate is found, exit the loop and print the duplicate.

# item = ["apple","banana","orange","apple","mango"]

item = ["apple","banana","orange","apple","mango"]

unique_item = set()

for item in item:
  if item in unique_item:
    print("Duplicate: ",item)
    break
  unique_item.add(item)



